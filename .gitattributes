# Auto-detect text files and normalize line endings to LF in the repo
* text=auto eol=lf
# Rust source is always text with LF
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
# Shell scripts must be LF even on Windows
*.sh text eol=lf
# Windows batch files need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
# OIDN vendored binaries — treat as binary, no diff/merge
vendor/oidn/bin/*.dll binary
vendor/oidn/bin/*.exe binary
vendor/oidn/lib/*.lib binary
vendor/oidn/lib/*.so* binary
vendor/oidn/lib/*.dylib binary
# 3D assets
*.obj text eol=lf
*.hdr binary
*.exr filter=lfs diff=lfs merge=lfs -text
*.png binary
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
